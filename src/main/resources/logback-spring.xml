<configuration>
    <!-- default log file resolved from Spring property 'logging.file.name' or fallback -->
    <property name="LOG_FILE" value="${logging.file.name:-logs/app.log}" />
    <!-- JSON message pattern reused by multiple encoders -->
    <property name="LOG_JSON_PATTERN" value='{"level":"%level","thread":"%thread","logger":"%logger","message":"%message","requestId":"%X{requestId:-}","user":"%X{user:-}","traceId":"%X{traceId:-}","spanId":"%X{spanId:-}"}'/>

    <!-- JSON Console Appender (structured logs) -->
    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>${LOG_JSON_PATTERN}</pattern>
                </pattern>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <!-- Rolling file appender with JSON encoder: rotate daily and by size -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/app-%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>${LOG_JSON_PATTERN}</pattern>
                </pattern>
                <stackTrace/>
            </providers>
        </encoder>
    </appender>

    <!-- Async wrappers to avoid blocking request threads on IO -->
    <appender name="ASYNC_JSON_CONSOLE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="JSON_CONSOLE" />
        <queueSize>5000</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <appender name="ASYNC_FILE" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="FILE" />
        <queueSize>5000</queueSize>
        <discardingThreshold>0</discardingThreshold>
    </appender>

    <!-- Production-safe defaults -->
    <logger name="com.taskmanager.app" level="INFO"/>

    <!-- Local profile keeps detailed debug visibility -->
    <springProfile name="local">
        <logger name="com.taskmanager.app" level="DEBUG"/>
        <logger name="com.taskmanager.app.controller" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>
    </springProfile>

    <root level="INFO">
        <appender-ref ref="ASYNC_JSON_CONSOLE" />
        <appender-ref ref="ASYNC_FILE" />
    </root>
</configuration>

